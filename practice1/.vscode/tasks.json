{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: gcc 활성 파일 빌드",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                    "-fdiagnostics-color=always",
                    "-g",
                    "-finput-charset=UTF-8",
                    "-fexec-charset=UTF-8",
                    "${file}",
                    "-o",
                    "${fileBasenameNoExtension}.exe"
                    ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "GCC로 현재 C 파일 빌드"
        }
    ]
}